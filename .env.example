# LLM providers, tried in this order (only those with a key are used)
LLM_CHAIN=groq,gemini,openai
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Where the worker finds the mock apps (defaults: mounted in the same server)
PORTAL_URL=http://127.0.0.1:8000/portal
ERP_URL=http://127.0.0.1:8000/erp
PORTAL_API_KEY=portal-dev-key
ERP_API_KEY=erp-dev-key
ERP_USER=ops
ERP_PASS=northwind-demo
# ERP_DATABASE_URL=postgresql+psycopg://...   (default: sqlite:///runs/erp.db)
